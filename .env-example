# A porta 3309 é apenas o mapeamento no host (docker-compose.yml: "3309:3306").
DB_HOST=mysql-ivi
DB_PORT=3306
DB_USER=tiniclick
DB_PASSWORD=mudar_senha
DB_NAME=tiniclick
